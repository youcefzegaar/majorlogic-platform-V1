{
    "name": "majorlogic-platform-v1",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "npm@10.8.2",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "demo": "node scripts/demo.js",
        "catalog:ingest": "node scripts/ingest-domain.js",
        "catalog:publish": "node scripts/publish-catalog.js",
        "scenarios:run": "node scripts/run-scenarios.js",
        "start:api": "node apps/api/src/server.js",
        "db:check": "node scripts/check-supabase-connection.js",
        "db:bootstrap": "node scripts/bootstrap-supabase.js",
        "db:migration:print": "node scripts/print-migrations.js",
        "test:regression": "node tests/regression-v1.test.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:node": "node tests/system.test.js",
        "tsc:check": "tsc --noEmit",
        "lint": "eslint ."
    },
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/static": "^9.1.3",
        "@google/generative-ai": "^0.24.1",
        "crypto-js": "^4.2.0",
        "dotenv": "^17.4.2",
        "fastify": "^5.8.5",
        "pg": "^8.20.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^20.19.41",
        "puppeteer": "^24.43.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.6"
    }
}
