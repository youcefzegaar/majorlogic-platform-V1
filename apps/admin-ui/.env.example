# Admin UI — Vite environment variables
# The admin-ui is a React SPA — all API calls go to the Railway backend at /admin/*.
# No additional environment variables are required for the Vite build.
# The Railway URL is hardcoded in vercel.json rewrites.

# Optionally override the API base URL for local development (leave unset in production)
# VITE_ADMIN_API_BASE=http://localhost:3010
