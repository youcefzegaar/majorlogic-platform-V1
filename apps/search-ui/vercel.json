{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://majorlogicapi-production.up.railway.app/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://majorlogicapi-production.up.railway.app/auth/:path*"
    },
    {
      "source": "/user/:path*",
      "destination": "https://majorlogicapi-production.up.railway.app/user/:path*"
    },
    {
      "source": "/go/:path*",
      "destination": "https://majorlogicapi-production.up.railway.app/go/:path*"
    },
    {
      "source": "/disclosure",
      "destination": "https://majorlogicapi-production.up.railway.app/disclosure"
    },
    {
      "source": "/privacy",
      "destination": "https://majorlogicapi-production.up.railway.app/privacy"
    },
    {
      "source": "/terms",
      "destination": "https://majorlogicapi-production.up.railway.app/terms"
    },
    {
      "source": "/how-we-work",
      "destination": "https://majorlogicapi-production.up.railway.app/how-we-work"
    },
    {
      "source": "/share/:token",
      "destination": "https://majorlogicapi-production.up.railway.app/share/:token"
    },
    {
      "source": "/robots.txt",
      "destination": "https://majorlogicapi-production.up.railway.app/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://majorlogicapi-production.up.railway.app/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
