# Search UI — Vite environment variables
# Copy to .env and fill in your values

# Supabase project credentials (required for auth & data)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API base URL — point to your deployed API server in production
# Leave unset (or set to empty string) to default to http://localhost:3010
VITE_API_URL=https://api.majorlogic.ai
