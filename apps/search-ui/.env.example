# Search UI — Vite environment variables
# Copy to .env and fill in your values

# API base URL — point to your deployed Railway API in production.
# Leave unset to default to https://majorlogicapi-production.up.railway.app
VITE_API_URL=https://majorlogicapi-production.up.railway.app

# Default domain used by the decision engine (leave as-is unless adding new domains)
VITE_DEFAULT_DOMAIN=laptop-student-us
