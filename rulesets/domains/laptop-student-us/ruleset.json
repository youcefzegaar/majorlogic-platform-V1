  "policies": {
    "budgetMustHold": true,
    "requireBadNews": true
  },
  "penalties": {
    "badNewsSeverity": {
      "low": 0.03,
      "med": 0.07,
      "high": 0.12
    },
    "stalePricePenalty": 3,
    "softGpuMismatchPenalty": 12,
    "riskPenaltyByTier": {
      "LOW": 0.0,
      "MEDIUM": 0.1,
      "HIGH": 0.3
    }
  },
  "selectionRules": {
    "cards": [
      "hero",
      "smart_budget",
      "future_proof"
    ],
    "hero": {
      "rule": "highest_match_score_after_risk",
      "cannotBeOpenBox": true,
      "cannotBeOutOfStock": true
    },
    "smartBudget": {
      "rule": "lowest_price_meeting_quality_gates",
      "mustShowTradeoff": true
    },
    "futureProof": {
      "rule": "best_upgrade_delta_within_plus_150_usd",
      "maxBudgetDeltaUsd": 150
    },

    "tieBreakersOrder": [
      "lower_risk",
      "higher_headroom",
      "higher_trust",
      "higher_resale",
      "lower_price"
    ]
  }
}