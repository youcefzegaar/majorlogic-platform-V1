# =============================================================================
# MajorLogic — متغيرات البيئة للإنتاج على Railway
# انسخ هذا الملف والصقه في: Railway → Variables
# =============================================================================

# ── قاعدة البيانات ──────────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection String → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── الأمان ───────────────────────────────────────────────────────────────────
# يجب أن يكون كل مفتاح 64 حرف عشوائي
# لتوليد مفتاح: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_RANDOM_CHARS
COOKIE_SECRET=REPLACE_WITH_64_RANDOM_CHARS
ADMIN_EXPORT_SECRET=REPLACE_WITH_64_RANDOM_CHARS
ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_CHARS

# ── حساب الإدارة ──────────────────────────────────────────────────────────
ADMIN_USER=admin
# توليد hash: node -e "const b=require('bcrypt');b.hash('YOUR_PASSWORD',10).then(console.log)"
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# ── الـ CORS ──────────────────────────────────────────────────────────────────
# ضع رابط Vercel هنا (majorlogic.tech)
ALLOWED_ORIGINS=https://majorlogic.tech,https://www.majorlogic.tech,https://admin.majorlogic.tech
FRONTEND_URL=https://majorlogic.tech

# ── الإعدادات العامة ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010
DEFAULT_DOMAIN=laptop-student-us
ENABLED_DOMAINS=laptop-student-us
LOG_LEVEL=info

# ── البريد الإلكتروني (اختياري) ──────────────────────────────────────────
# Resend.com مجاني 3000 إيميل/شهر
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=REPLACE_WITH_RESEND_API_KEY
SMTP_FROM=MajorLogic <hello@majorlogic.tech>

# ── Sentry (اختياري — لمراقبة الأخطاء) ──────────────────────────────────
SENTRY_DSN=

# ── Telegram (اختياري — للتنبيهات) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
