# =============================================================================
# MajorLogic — متغيرات البيئة للإنتاج
# انسخ هذا الملف وضع القيم الصحيحة في لوحة Railway
# =============================================================================

# ── قاعدة البيانات ──────────────────────────────────────────────────────────
# الرابط الكامل لـ Supabase — تجده في: Supabase → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── الأمان ───────────────────────────────────────────────────────────────────
# مفاتيح سرية — يجب أن يكون كل منها 32 حرف على الأقل وعشوائياً تماماً
# لتوليد مفتاح عشوائي: https://generate-secret.vercel.app/64
JWT_SECRET=REPLACE_WITH_64_RANDOM_CHARS
COOKIE_SECRET=REPLACE_WITH_64_RANDOM_CHARS
ADMIN_EXPORT_SECRET=REPLACE_WITH_64_RANDOM_CHARS
ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_CHARS

# ── حساب الإدارة ──────────────────────────────────────────────────────────
# اسم المستخدم للوحة /admin
ADMIN_USER=admin
# كلمة المرور المشفرة — شغّل: node -e "const b=await import('bcrypt');console.log(await b.hash('YOUR_PASSWORD',10))"
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# ── الـ CORS والـ Frontend ────────────────────────────────────────────────
# رابط الواجهة على Vercel — مثال: https://majorlogic.vercel.app
FRONTEND_URL=https://YOUR_VERCEL_URL.vercel.app
# نفس الرابط هنا
ALLOWED_ORIGINS=https://YOUR_VERCEL_URL.vercel.app

# ── الإعدادات العامة ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010
DEFAULT_DOMAIN=laptop-student-us
ENABLED_DOMAINS=laptop-student-us
LOG_LEVEL=info

# ── البريد الإلكتروني (SMTP) ──────────────────────────────────────────────
# للإيميلات: استخدم Resend.com (مجاني 3000 إيميل/شهر) أو SendGrid
# Resend: SMTP_HOST=smtp.resend.com | PORT=465 | USER=resend | PASS=your_api_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=REPLACE_WITH_RESEND_API_KEY
SMTP_FROM=MajorLogic <hello@majorlogic.ai>

# ── Sentry (مراقبة الأخطاء) ──────────────────────────────────────────────
# أنشئ مشروعاً مجانياً على sentry.io واحصل على DSN
# اختياري — لكن موصى به جداً
SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX

# ── Telegram Bot (التنبيهات) ──────────────────────────────────────────────
# 1. تحدث مع @BotFather على Telegram وأنشئ بوتاً جديداً
# 2. احصل على token البوت
# 3. أرسل رسالة للبوت ثم افتح: https://api.telegram.org/bot<TOKEN>/getUpdates
#    لتحصل على chat_id الخاص بك
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID

# ── AI (اختياري) ─────────────────────────────────────────────────────────
# إذا كانت المنصة تستخدم Claude أو Gemini لتوليد الشروحات
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
