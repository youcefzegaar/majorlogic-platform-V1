        "portability_score": 0.2
      }
    },
    "medical": {
      "weights": {
        "userPreferenceScore": 0.55,
        "value_score": 0.3,
        "portability_score": 0.15
      }
    },
    "business": {
      "weights": {
        "userPreferenceScore": 0.5,
        "value_score": 0.3,
        "portability_score": 0.2
      }
    },
    "arts": {
      "weights": {
        "userPreferenceScore": 0.55,
        "specs.display": 0.25,
        "portability_score": 0.2
      }
    }
  },
  "selectionStrategy": {
    "cardSlots": [
      {
        "type": "hero",
        "pickBy": "highest_score"
      },
      {
        "type": "smart_budget",
        "pickBy": "best_ratio",
        "priceField": "market.bestOffer.priceUsd"
      },
      {
        "type": "future_proof",
        "pickBy": "highest_score",
        "minScore": 35
      }
    ],
    "noDuplicates": true
  },
  "outputTemplate": {
    "title": "{entity.title}",
    "priceUsd": "{entity.market.bestOffer.priceUsd}",
    "whyThis": "{story}",
    "badNews": "{tradeoff}"
  },
  "conflictMap": {
    "performance:battery": 60,
    "performance:portability": 55,
    "gaming:battery": 70,
    "video_4k:battery": 50,
    "virtual_machines:portability": 45
  },
