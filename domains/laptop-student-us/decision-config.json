            "right": 85
          },
          "amount": 10,
          "reason": "Thermal throttling limits sustained compute for CS workloads"
        }
      }
    },
    "engineering": {
      "weights": {
        "userPreferenceScore": 0.45,
        "specs.performance": 0.35,
        "portability_score": 0.2
      },
      "penalties": {
        "thermal_throttle": {
          "condition": {
            "op": "gt",
