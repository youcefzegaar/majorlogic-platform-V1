      "reason_seller_trust_gate": "يأتي من مصدر ذو تصنيف ثقة منخفض"
    }
  },
  "profileMapping": {
    "budgetUsd": "budget",
    "major": "major"
  },
  "attributes": {
    "market.bestOffer.priceUsd": {
      "type": "numeric",
      "label": "Price USD"
    },
    "specs.ramGb": {
      "type": "numeric",
      "label": "RAM"
    },
    "specs.storageGb": {
      "type": "numeric",
      "label": "Storage"
    },
    "specs.performance": {
      "type": "numeric",
      "label": "Performance Score"
    },
    "specs.battery": {
      "type": "numeric",
      "label": "Battery Score"
    },
    "specs.portability": {
      "type": "numeric",
      "label": "Portability Score"
    },
    "specs.display": {
      "type": "numeric",
      "label": "Display Score"
    },
    "specs.thermals": {
      "type": "numeric",
      "label": "Thermal Throttle Index"
    },
    "economicSignals.resaleScore": {
      "type": "numeric",
      "label": "Resale Value Index"
    },
    "userPrefPerformance": {
      "type": "numeric",
      "label": "User Preference: Performance"
    },
    "userPrefBattery": {
      "type": "numeric",
      "label": "User Preference: Battery"
    },
    "userPrefPortability": {
      "type": "numeric",
      "label": "User Preference: Portability"
    },
    "userPrefDisplay": {
      "type": "numeric",
      "label": "User Preference: Display"
    },
    "userPrefResale": {
      "type": "numeric",
      "label": "User Preference: Resale"
    }
  },
  "metrics": {
    "portability_score": {
      "label": "Portability Index",
      "formula": {
        "op": "clamp",
        "args": [
          {
            "op": "average",
            "args": [
              "specs.battery",
              "specs.portability"
            ]
          },
          0,
          100
        ]
      }
    },
    "value_score": {
      "label": "Price/Performance Value",
      "formula": {
        "op": "clamp",
        "args": [
          {
            "op": "add",
            "args": [
              100,
              {
                "op": "multiply",
                "args": [
                  "market.bestOffer.priceUsd",
                  -0.015
                ]
              }
            ]
          },
          0,
          100
        ]
      }
    },
    "userPreferenceScore": {
      "label": "User Preference Weighted Score",
      "formula": {
        "op": "clamp",
        "args": [
          {
            "op": "average",
            "args": [
              {
                "op": "multiply",
                "args": [
                  "specs.performance",
                  "userPrefPerformance"
                ]
              },
              {
                "op": "multiply",
                "args": [
                  "specs.battery",
                  "userPrefBattery"
                ]
              },
              {
                "op": "multiply",
                "args": [
                  "specs.portability",
                  "userPrefPortability"
                ]
              },
              {
                "op": "multiply",
                "args": [
                  "specs.display",
                  "userPrefDisplay"
                ]
              },
              {
                "op": "multiply",
                "args": [
                  "economicSignals.resaleScore",
                  "userPrefResale"
                ]
              }
            ]
          },
          0,
          100
        ]
      }
    }
  },
  "gates": {
    "within_budget": {
      "node": "Budget Constraint",
      "humanMeaning": "Device exceeds the specified budget",
      "weight": 0.8,
      "condition": {
        "op": "lte",
        "left": "market.bestOffer.priceUsd",
        "right": "budget"
      }
    },
    "min_ram": {
      "node": "RAM Minimum",
      "humanMeaning": "Insufficient RAM for modern workflows",
      "weight": 1.0,
      "condition": {
        "op": "gte",
        "left": "specs.ramGb",
        "right": 8
      }
    },
    "seller_trust_gate": {
      "node": "Seller Trust Gate",
      "humanMeaning": "Source is from an unverified or risky marketplace",
      "weight": 1.0,
      "condition": {
        "op": "lte",
        "left": "market.sellerTier",
        "right": 3
      }
    },
    "gaming_gpu_requirement": {
      "node": "Gaming GPU Constraint",
      "humanMeaning": "Integrated graphics are insufficient for high-end gaming needs",
      "weight": 1.0,
      "condition": {
        "op": "or",
        "args": [
          {
            "op": "lt",
            "left": "slider_gaming",
            "right": 70
          },
          {
            "op": "not_equal",
            "left": "specs.gpuClass",
            "right": "integrated"
          }
        ]
      }
    },
    "vm_ram_requirement": {
      "node": "VM RAM Constraint",
      "humanMeaning": "Virtual machine workloads require at least 16GB RAM",
      "weight": 1.0,
      "condition": {
        "op": "or",
        "args": [
          {
            "op": "lt",
            "left": "slider_virtual_machines",
            "right": 70
          },
          {
            "op": "gte",
            "left": "specs.ramGb",
            "right": 16
          }
        ]
      }
    }
  },
  "rulesets": {
    "general": {
      "isDefault": true,
      "sacrifice_portability": "Weight & Bulk",
      "sacrifice_battery": "Battery Life",
      "sacrifice_budget": "Initial Budget",
      "sacrifice_value": "Resale Value",
      "weights": {
        "userPreferenceScore": 0.55,
        "value_score": 0.25,
        "portability_score": 0.2
      },
      "penalties": {
        "thermal_throttle": {
          "condition": {
            "op": "gt",
            "left": "specs.thermals",
            "right": 85
          },
          "amount": 12,
          "reason": "Aggressive thermal throttling detected in reviews"
        }
      }
    },
    "ar": {
      "score_performance_score": "الأداء",
      "score_display_score": "جودة الشاشة",
      "score_portability_score": "سهولة الحمل",
      "score_battery_score": "عمر البطارية",
      "score_value_score": "القيمة الاقتصادية",
      "sacrifice_portability": "سهولة التنقل (الجهاز ثقيل)",
      "sacrifice_battery": "عمر البطارية (تحتاج للشاحن دائماً)",
      "sacrifice_budget": "الميزانية المحددة (تجاوز السعر)",
      "sacrifice_value": "القيمة المادية عند البيع"
    },
    "cs": {
