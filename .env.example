# Root platform runtime
NODE_ENV=development

# Supabase project URL for future API/auth/storage integration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Primary database connection used by the platform backbone
# Recommended format:
# postgres://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project-ref.supabase.co:5432/postgres

# Production Settings
LOG_LEVEL=info
DEFAULT_AFFILIATE_TAG=majorlogic-20
ADMIN_USER=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_EXPORT_SECRET=your_secure_export_secret_here