# Root platform runtime
NODE_ENV=development

# Supabase project URL for future API/auth/storage integration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Primary database connection used by the platform backbone
# Recommended format:
# postgres://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project-ref.supabase.co:5432/postgres

# Production Settings
LOG_LEVEL=info
PORT=3010
DEFAULT_DOMAIN=laptop-student-us
FRONTEND_URL=https://majorlogic.tech
PUBLIC_BASE_URL=https://majorlogic.tech
DEFAULT_AFFILIATE_TAG=majorlogic-20
ADMIN_USER=admin

# CORS — comma-separated list of allowed origins (required in production, must all be https://)
ALLOWED_ORIGINS=https://majorlogic.tech,https://www.majorlogic.tech

# Generate with: node -e "const bcrypt=require('bcrypt');bcrypt.hash('YourPassword123!',10).then(console.log)"
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
ADMIN_EXPORT_SECRET=your_secure_export_secret_here
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_here
COOKIE_SECRET=your_cookie_secret_min_32_chars_here
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_min_32_chars_here

# User accounts (M3) — public base URL used for shared decision links
# Set to your domain in production, e.g. https://majorlogic.tech
BASE_URL=http://localhost:3010

# Search UI (Vite — prefix all with VITE_)
# Must point to the API server; in development use the local address
VITE_API_URL=http://localhost:3010