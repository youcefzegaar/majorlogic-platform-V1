{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/postgres-persistence/src/crypto.js",
    "apps/api/src/config/validate-env.js",
    "packages/decision-compiler/src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "apps/*/src/**",
    "packages/*/src/index.js"
  ]
}
